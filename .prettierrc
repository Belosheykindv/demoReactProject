{
  "trailingComma": "all",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "jsxSingleQuote": true,
  "quoteProps": "as-needed",
  "printWidth": 100,
  "useTabs": false,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "<TYPES>",
    "<TYPES>^[.]",
    "",
    "^react",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/",
    "^@/(.*)$",
    "./(.*)/(.*)$",
    "",
    "./*.*.scss"
  ]
}